arr2 = np.array([
[2, 3, 5],
[14, 6, 8],
[11, 13, 17],
[7, 10, 13]
])


def is_prime(n):
    if n < 2:
        return False
    for i in range(2, n):
        if n % i == 0:     
            return False
    return True


def prime_rows(arr):
    prime = []
    for row in arr:
        for value in row:
            if is_prime(value):
                prime.append(row)       
    return np.array(prime)


print(prime_rows(arr2))



